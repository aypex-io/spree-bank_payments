<%# app/views/spree/admin/bank_transfers/index.html.erb %>
<h1>Unmatched bank transfers</h1>

<p>
  <%= link_to 'Record a received transfer', spree.new_admin_bank_transfer_path, class: 'btn btn-primary' %>
</p>

<% if @transfers.empty? %>
  <p>Nothing waiting. Every observed transfer has been matched or ignored.</p>
<% else %>
  <table class="table">
    <thead>
      <tr>
        <th>Received</th><th>Amount</th><th>Payer</th>
        <th>Reference as sent</th><th>Suggested orders</th><th></th>
      </tr>
    </thead>
    <tbody>
      <% @transfers.each do |transfer| %>
        <tr>
          <td><%= l(transfer.occurred_at, format: :short) %></td>
          <td><%= transfer.money.to_s %></td>
          <td><%= transfer.payer_name %></td>
          <td><code><%= transfer.reference_raw.presence || '—' %></code></td>
          <td>
            <%# Suggestions are ranked partly on fuzzy pg_trgm payer-name
                similarity, so a plausible-looking name is not evidence of who
                paid. On a pooled account it is not evidence at all: every
                customer of the provider sends to the same coordinates, so two
                unrelated payers land here indistinguishable except by the
                reference they quoted. Say so on the screen where the admin is
                about to click, not only on the accounts screen. %>
            <% if transfer.bank_account&.pooled? %>
              <div class="alert alert-warning py-1 px-2 mb-2">
                <strong>Pooled account.</strong> These coordinates are shared
                with other customers of the provider, so the reference is the
                only thing identifying who paid. Check the reference above
                against the order before applying — a suggestion here is a
                guess, not a match.
              </div>
            <% end %>
            <% Array(@suggestions[transfer.id]).each do |suggestion| %>
              <%# Currency compared case-insensitively, matching the controller's
                  own casecmp guard -- otherwise 'gbp' vs 'GBP' (the same
                  currency) renders a mismatch badge the controller would never
                  actually stop. %>
              <% mismatched = suggestion.amount != transfer.amount ||
                              suggestion.currency.to_s.casecmp(transfer.currency.to_s) != 0 %>
              <% awaiting_confirmation = mismatched &&
                                         @confirm_transfer_id == transfer.id &&
                                         @confirm_payment_session_id == suggestion.id %>
              <%= form_tag spree.apply_admin_bank_transfer_path(transfer), method: :put, class: 'd-inline' do %>
                <%= hidden_field_tag :payment_session_id, suggestion.id %>
                <% if mismatched %>
                  <span class="badge bg-warning text-dark">Amount/currency mismatch — session expects <%= suggestion.money %></span>
                  <%# No pre-filled confirm_mismatch here: the controller's guard
                      must actually bite on the first click. The confirmation
                      field appears only after that refusal, on the one pair the
                      admin was just shown the numbers for. And the dialog uses
                      data-turbo-confirm, not data-confirm -- Spree 5.6 admin is
                      Turbo, which ignores the rails-ujs attribute entirely, so
                      the old markup produced no prompt at all. %>
                  <% if awaiting_confirmation %>
                    <%= hidden_field_tag :confirm_mismatch, '1' %>
                    <%= submit_tag "Yes — apply #{transfer.money} to #{suggestion.order.number} anyway",
                          class: 'btn btn-sm btn-danger',
                          data: { turbo_confirm: "Transfer is #{transfer.money} but #{suggestion.order.number} expects #{suggestion.money}. Apply anyway?" } %>
                  <% else %>
                    <%= submit_tag "Apply anyway to #{suggestion.order.number}", class: 'btn btn-sm btn-warning',
                          data: { turbo_confirm: "Transfer is #{transfer.money} but #{suggestion.order.number} expects #{suggestion.money}. Apply anyway?" } %>
                  <% end %>
                <% else %>
                  <%= submit_tag "#{suggestion.order.number} — #{suggestion.money}", class: 'btn btn-sm btn-primary' %>
                <% end %>
              <% end %>
            <% end %>
            <% if Array(@suggestions[transfer.id]).empty? %>—<% end %>
          </td>
          <td>
            <%= form_tag spree.ignore_admin_bank_transfer_path(transfer), method: :put do %>
              <%= text_field_tag :reason, nil, placeholder: 'Reason', class: 'form-control form-control-sm d-inline w-auto' %>
              <%= submit_tag 'Ignore', class: 'btn btn-sm btn-outline-secondary' %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <%== @pagy.series_nav %>
<% end %>

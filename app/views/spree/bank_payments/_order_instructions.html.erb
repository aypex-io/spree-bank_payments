<%# Read by the customer to make their transfer -- from the order confirmation
    page and the "instructions ready" email. `payment_session` is a
    Spree::PaymentSessions::BankTransfer.

    The reference, amount, and deadline are the functional core of this
    partial: auto-matching depends entirely on the customer quoting the
    reference correctly, so it must stay visually unmissable. %>
<%# Deliberately the session's own account, not the currently offered one --
    see Spree::PaymentSessions::BankTransfer#bank_detail_sets. Switching the
    offered account must never change what an already-quoted customer is
    shown. %>
<% detail_sets = payment_session.bank_detail_sets %>

<section class="bank-transfer-instructions">
  <div class="bank-transfer-instructions__highlight">
    <h2><%= Spree.t('bank_payments.reference') %></h2>

    <%# The reference is a plain text node inside <code> either way, so it
        stays selectable/copyable by hand if JS is unavailable -- the button
        is a convenience on top, not the only way to copy it. Inline
        onclick, no Stimulus/importmap/build step: this gem ships no
        app/javascript, and a data-controller with no matching controller
        class is silently inert in a host app. %>
    <p class="bank-transfer-reference">
      <code class="bank-transfer-reference__code"><%= payment_session.reference %></code>
      <button
        type="button"
        class="bank-transfer-reference__copy"
        data-copy-label="<%= Spree.t('bank_payments.copy') %>"
        data-copy-done-label="<%= Spree.t('bank_payments.copied') %>"
        onclick="
          var btn = this;
          var text = btn.previousElementSibling.textContent;
          var done = btn.getAttribute('data-copy-done-label');
          var reset = btn.getAttribute('data-copy-label');
          var restore = function () { btn.textContent = reset; };
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(function () {
              btn.textContent = done;
              setTimeout(restore, 2000);
            });
          }
        "
      ><%= Spree.t('bank_payments.copy') %></button>
    </p>

    <p class="bank-transfer-reference-help"><%= Spree.t('bank_payments.reference_help') %></p>

    <dl class="bank-transfer-amount">
      <dt><%= Spree.t('bank_payments.amount_to_transfer') %></dt>
      <dd class="bank-transfer-amount__value"><%= payment_session.money.to_s %></dd>

      <dt><%= Spree.t('bank_payments.transfer_by') %></dt>
      <dd><%= l(payment_session.expires_at.to_date, format: :long) if payment_session.expires_at %></dd>
    </dl>
  </div>

  <% detail_sets.each do |set| %>
    <div class="bank-transfer-instructions__account">
      <% if set.label.present? %>
        <h3><%= set.label %></h3>
      <% end %>

      <dl>
        <% if set.beneficiary_name.present? %>
          <dt><%= Spree.t('bank_payments.beneficiary') %></dt>
          <dd><%= set.beneficiary_name %></dd>
        <% end %>

        <%# Label/value pairs, rendered generically: bank coordinates are not
            standardised across countries, so the view must never assume which
            fields exist. %>
        <% set.fields.each do |label, value| %>
          <dt><%= label %></dt>
          <dd><%= value %></dd>
        <% end %>
      </dl>
    </div>
  <% end %>

  <p><%= Spree.t('bank_payments.dispatch_note') %></p>
</section>

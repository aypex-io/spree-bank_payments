<p><%= Spree.t('bank_payments.pay_within', days: @days_remaining) %></p>

<h1><%= Spree.t('bank_payments.reference') %>: <%= @session.reference %></h1>

<p><%= Spree.t('bank_payments.reference_help') %></p>

<p>
  <strong><%= Spree.t('bank_payments.amount_to_transfer') %>:</strong>
  <%= @session.money.to_s %>
</p>

<% @detail_sets.each do |set| %>
  <% if set.label.present? %><h3><%= set.label %></h3><% end %>

  <ul>
    <% if set.beneficiary_name.present? %>
      <li><%= Spree.t('bank_payments.beneficiary') %>: <%= set.beneficiary_name %></li>
    <% end %>

    <%# Label/value pairs, rendered generically: bank coordinates are not
        standardised across countries, so the view must never assume which
        fields exist. %>
    <% set.fields.each do |label, value| %>
      <li><%= label %>: <%= value %></li>
    <% end %>
  </ul>
<% end %>

<p><%= Spree.t('bank_payments.dispatch_note') %></p>

<p>
  <strong><%= t('spree.bank_payments.reference') %>:</strong> <%= @session.reference %><br>
  <strong><%= t('spree.bank_payments.amount_to_transfer') %>:</strong> <%= @session.money.to_s %><br>
  <strong><%= t('spree.bank_payments.transfer_by') %>:</strong> <%= deadline %>
</p>

<p><%= t('spree.bank_payments.reference_help') %></p>

<% @detail_sets.each do |set| %>
  <% if set.label.present? %><h3><%= set.label %></h3><% end %>

  <ul>
    <% if set.beneficiary_name.present? %>
      <li><%= t('spree.bank_payments.beneficiary') %>: <%= set.beneficiary_name %></li>
    <% end %>

    <%# Label/value pairs, rendered generically: bank coordinates are not
        standardised across countries, so the view must never assume which
        fields exist. %>
    <% set.fields.each do |label, value| %>
      <li><%= label %>: <%= value %></li>
    <% end %>
  </ul>
<% end %>
